# Database
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Supabase Auth
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Etsy Integration
ETSY_API_KEY="your-etsy-api-key"
ETSY_REDIRECT_URI="http://localhost:3000/api/etsy/callback"

# Etsy Mock Mode: 'real' | 'mock'
# Set to 'mock' for development without Etsy API keys
ETSY_MODE=real

# Etsy Safety Features
# Enable dry run mode (returns diff without making changes)
ETSY_DRY_RUN=false
# Delay between API calls in milliseconds
ETSY_THROTTLE_DELAY_MS=1000
# Maximum updates per minute
ETSY_MAX_UPDATES_PER_MIN=30

# Development bypass (only enable for local development)
# DEV_BYPASS_AUTH=true
