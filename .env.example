# Database connection string
# For Neon: postgresql://user:password@ep-xxx.region.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/savvy_hampers"

# Supabase (Auth)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Optional server-side names (backend will also read VITE_* if these are unset)
# SUPABASE_URL="https://your-project-id.supabase.co"
# SUPABASE_ANON_KEY="your-supabase-anon-key"

# Dev only: bypass Supabase auth in both UI and API (do not enable in production)
# VITE_DEV_BYPASS_AUTH="true"

# Etsy API (for inventory sync)
# Get these from https://www.etsy.com/developers/your-apps
ETSY_API_KEY="your-etsy-api-key"
ETSY_SHARED_SECRET="your-etsy-shared-secret"
ETSY_REDIRECT_URI="https://yourdomain.com/api/etsy/callback"
