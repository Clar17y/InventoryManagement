# Database
# Runtime connection string (recommend Neon pooled / pgBouncer for lower idle compute)
# If using Neon pooled, add `pgbouncer=true` for Prisma.
DATABASE_URL="postgresql://user:password@host-pooler:5432/database?sslmode=require&pgbouncer=true"

# Direct (non-pooled) connection string for Prisma Migrate/Studio
DIRECT_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Supabase Auth
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Etsy Integration
ETSY_API_KEY="your-etsy-api-key"
ETSY_REDIRECT_URI="http://localhost:3000/api/etsy/callback"

# Etsy Mock Mode: 'real' | 'mock'
# Set to 'mock' for development without Etsy API keys
ETSY_MODE=real

# Allow validated Etsy Payment API aggregate fees to replace calculated totals.
# Keep false until one attributed and one non-attributed order match Etsy statements.
ETSY_PAYMENT_FEES_VALIDATED=false

# Etsy Mock Fixtures (only used when ETSY_MODE=mock)
# Target number of ACTIVE listings returned by the mock client.
# If greater than the built-in fixtures (7 active listings), extra listings are generated.
# ETSY_MOCK_ACTIVE_LISTINGS=150
# For generated listings: every Nth listing will be multi-variant (default: 10)
# ETSY_MOCK_MULTI_VARIANT_EVERY=10
# For generated multi-variant listings: number of variants per listing (default: 3)
# ETSY_MOCK_VARIANTS_PER_LISTING=3

# Etsy Safety Features
# Enable dry run mode (returns diff without making changes)
ETSY_DRY_RUN=false
# Delay between API calls in milliseconds
ETSY_THROTTLE_DELAY_MS=1000
# Maximum updates per minute
ETSY_MAX_UPDATES_PER_MIN=30

# Development bypass (only enable for local development)
# DEV_BYPASS_AUTH=true

# Client-side API response validation (Zod)
# Set to 'false' to disable (not recommended)
# VITE_VALIDATE_API=true
