generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PickRule {
  FIFO
  FEFO
  CHEAPEST
  MANUAL
}

enum ExpenseCategory {
  ADVERTISING
  LISTING_FEE
  POSTAGE
  PACKAGING
  STOCK
  OTHER
}

model ComponentCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  pickRule    PickRule @default(FIFO)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products           Product[]
  hamperRequirements HamperRequirement[]
  variantMappings    HamperVariantMapping[]
}

model Product {
  id         String            @id @default(cuid())
  name       String
  categoryId String
  category   ComponentCategory @relation(fields: [categoryId], references: [id])
  unit       String            @default("units") // units, grams, ml, metres
  lowStockThreshold Int        @default(5) // Alert when stock <= this value, 0 = no alert
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  barcodes        ProductBarcode[]
  costs           ProductCost[]
  lots            InventoryLot[]
  variantMappings HamperVariantMapping[]
  suppliers       ProductSupplier[]
}

model ProductBarcode {
  id        String   @id @default(cuid())
  barcode   String   @unique
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  @@index([productId])
}

model ProductCost {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitCost      Decimal   @db.Decimal(10, 4)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  @@index([productId, effectiveFrom])
}

model InventoryLot {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Decimal   @db.Decimal(10, 3)
  remaining  Decimal   @db.Decimal(10, 3)
  unitCost   Decimal   @db.Decimal(10, 4)
  receivedAt DateTime  @default(now())
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  consumptions SaleConsumption[]

  @@index([productId, receivedAt])
  @@index([productId, expiresAt])
}

model Hamper {
  id                 String   @id @default(cuid())
  name               String
  etsyListingId      String?  @unique
  etsyIsEnabled      Boolean  @default(true)
  sellingPrice       Decimal  @db.Decimal(10, 2)
  indicativeQuantity Int?
  hasVariants        Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  requirements HamperRequirement[]
  variants     HamperVariant[]
  saleLines    SaleLine[]
}

model HamperRequirement {
  id         String            @id @default(cuid())
  hamperId   String
  hamper     Hamper            @relation(fields: [hamperId], references: [id], onDelete: Cascade)
  categoryId String
  category   ComponentCategory @relation(fields: [categoryId], references: [id])
  quantity   Decimal           @db.Decimal(10, 3)
  isOptional Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([hamperId, categoryId])
}

// Represents a specific variant (e.g., "Grey Star" version of the hamper)
model HamperVariant {
  id                 String   @id @default(cuid())
  hamperId           String
  hamper             Hamper   @relation(fields: [hamperId], references: [id], onDelete: Cascade)
  name               String   // "Grey Star", "Floral", "Bee"
  sellingPrice       Decimal? @db.Decimal(10, 2) // Override price for this variant (null = use hamper price)
  etsySku            String?  @unique // For future Etsy sync: "LPH-GS"
  etsyProductId      String?  @unique // Etsy's product_id for variant matching
  etsyIsEnabled      Boolean  @default(true)
  indicativeQuantity Int?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  mappings  HamperVariantMapping[]
  saleLines SaleLine[]

  @@unique([hamperId, name])
}

// Maps a variant's category requirement to a specific product (or alternatives with priority)
// Multiple mappings per category = alternatives, not required products. Priority 1 = first choice.
model HamperVariantMapping {
  id         String            @id @default(cuid())
  variantId  String
  variant    HamperVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  categoryId String            // Which category requirement this maps
  category   ComponentCategory @relation(fields: [categoryId], references: [id])
  productId  String
  product    Product           @relation(fields: [productId], references: [id])
  priority   Int               @default(1) // 1-based, lower = higher priority

  @@unique([variantId, categoryId, priority])   // No duplicate priorities within category
  @@unique([variantId, categoryId, productId])  // No duplicate products within category
  @@index([variantId])
}

model Sale {
  id                String    @id @default(cuid())
  saleDate          DateTime  @default(now())
  etsyOrderId       String?   @unique
  saleChannel       String    @default("etsy") // "etsy" | "direct" | "fair"
  grossRevenue      Decimal   @db.Decimal(10, 2)
  postageCharged    Decimal   @db.Decimal(10, 2) @default(0) // What customer pays
  postageCost       Decimal   @db.Decimal(10, 2) @default(0) // What we pay Royal Mail
  etsyFees          Decimal   @db.Decimal(10, 2) @default(0) // Total of all fee breakdown fields
  packagingOverhead Decimal   @db.Decimal(10, 2) @default(0)
  netRevenue        Decimal   @db.Decimal(10, 2)
  totalCost         Decimal   @db.Decimal(10, 2)
  margin            Decimal   @db.Decimal(10, 2)
  notes             String?
  isHistorical      Boolean   @default(false) // True for imported historical data
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Detailed Etsy fee breakdown
  transactionFee        Decimal @db.Decimal(10, 2) @default(0)
  postageTransactionFee Decimal @db.Decimal(10, 2) @default(0)
  regulatoryFee         Decimal @db.Decimal(10, 2) @default(0)
  processingFee         Decimal @db.Decimal(10, 2) @default(0)
  vatOnProcessingFee    Decimal @db.Decimal(10, 2) @default(0)
  listingFee            Decimal @db.Decimal(10, 2) @default(0)

  lines SaleLine[]

  @@index([saleDate])
  @@index([saleChannel])
}

model SaleLine {
  id          String         @id @default(cuid())
  saleId      String
  sale        Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  hamperId    String?        // Optional for bespoke items
  hamper      Hamper?        @relation(fields: [hamperId], references: [id])
  variantId   String?        // Optional: which variant was sold
  variant     HamperVariant? @relation(fields: [variantId], references: [id])
  description String?        // For bespoke items: "Custom Baby Hamper for Sarah"
  quantity    Int            @default(1)
  unitPrice   Decimal        @db.Decimal(10, 2)
  lineCost    Decimal        @db.Decimal(10, 2)
  createdAt   DateTime       @default(now())

  consumptions SaleConsumption[]
}

model SaleConsumption {
  id         String       @id @default(cuid())
  saleLineId String
  saleLine   SaleLine     @relation(fields: [saleLineId], references: [id], onDelete: Cascade)
  lotId      String
  lot        InventoryLot @relation(fields: [lotId], references: [id])
  quantity   Decimal      @db.Decimal(10, 3)
  unitCost   Decimal      @db.Decimal(10, 4)
  createdAt  DateTime     @default(now())
}

model EtsyFeeConfig {
  id                String    @id @default(cuid())
  name              String
  transactionFee    Decimal   @db.Decimal(5, 4) // 0.065 = 6.5%
  regulatoryFee     Decimal   @db.Decimal(5, 4) // 0.0032 = 0.32%
  paymentFeePercent Decimal   @db.Decimal(5, 4) // 0.04 = 4%
  paymentFeeFixed   Decimal   @db.Decimal(10, 2) // £0.20
  vatRate           Decimal   @db.Decimal(5, 4) // 0.20 = 20%
  listingFee        Decimal   @db.Decimal(10, 2) // £0.15
  effectiveFrom     DateTime  @default(now())
  effectiveTo       DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
}

model PackagingOverhead {
  id            String    @id @default(cuid())
  name          String
  costPerOrder  Decimal   @db.Decimal(10, 4)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

model BusinessExpense {
  id            String          @id @default(cuid())
  date          DateTime        @default(now())
  category      ExpenseCategory
  supplier      String?         // "Etsy", "Royal Mail", "Amazon", etc.
  description   String
  amountIncVat  Decimal         @db.Decimal(10, 2)
  amountExcVat  Decimal         @db.Decimal(10, 2)
  isActive      Boolean         @default(true)
  isHistorical  Boolean         @default(false) // True for imported historical data
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([date])
  @@index([category])
}

model EtsyCredentials {
  id           String   @id @default(cuid())
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  shopId       String
  shopName     String
  userId       String   @unique // Etsy user ID - unique per account
  loginName    String?          // Etsy username for display
  isDefault    Boolean  @default(false) // Which account to use for API calls
  isAppOwner   Boolean  @default(false) // True for the app owner account
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isDefault])
}

model PostageTier {
  id         String   @id @default(cuid())
  etsyCharge Decimal  @db.Decimal(10, 2)
  actualCost Decimal  @db.Decimal(10, 2)
  label      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([etsyCharge])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ProductSupplier[]
}

model ProductSupplier {
  id         String   @id @default(cuid())
  productId  String
  supplierId String
  product    Product  @relation(fields: [productId], references: [id])
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  @@unique([productId, supplierId])
  @@index([productId])
  @@index([supplierId])
}
